FILES = "src/main.zig"
OUT = "grit"
DEBUG_FLAGS = "-O Debug -freference-trace=10 -lc"
RELEASE_FLAGS = "-O ReleaseFast -fstrip -lc"

clean {
    @parallel
    "rm -f *.exe"
    "rm -f *.pdb"
    "rm -f $OUT"
    "rm -f $OUT-d"
}

@default
debug {
    @if OS == "windows" {
        "zig build-exe $FILES -femit-bin=$OUT-d.exe $DEBUG_FLAGS"
    }

    @if OS == "linux" {
        "zig build-exe $FILES -femit-bin=$OUT-d $DEBUG_FLAGS"
    }
}

release {
    @if OS == "windows" {
        "zig build-exe $FILES -femit-bin=$OUT.exe $RELEASE_FLAGS"
    }

    @if OS == "linux" {
        "zig build-exe $FILES -femit-bin=$OUT $RELEASE_FLAGS"
    }
}

install {
  @if OS == "windows" {
    "copy $OUT.exe c:\grit"
    "copy LICENSE c:\grit"
  }

  @if OS == "linux" {
    "sudo mv grit /usr/bin/grit"
  }
}

test {
    @if GRIT_VER >= "0.6.3" {
        "echo $GRIT_VER >= 0.6.3"
    }
}
