FILES = "src/main.zig"
OUT = "grit"
DEBUG_FLAGS = "-O Debug -freference-trace=10 -lc"
RELEASE_FLAGS = "-O ReleaseFast -fstrip -lc"

clean {
  @parallel
  "rm -f *.exe"
  "rm -f *.pdb"
  "rm -f $OUT"
  "rm -f $OUT-d"
}

@default
debug {
  "zig build-exe $FILES -femit-bin=$OUT-d $DEBUG_FLAGS"
}

release {
  "zig build-exe $FILES -femit-bin=$OUT $RELEASE_FLAGS"
}

linux {
	"zig build-exe $FILES -femit-bin=$OUT $RELEASE_FLAGS -target x86_64-linux"
}

install {
  @parallel
  "copy $OUT.exe c:\grit"
  "copy LICENSE c:\grit"
}

test {
  @if os == "linux" {
    'echo "os == linux"'
  }
  'echo "hello world"'
}
