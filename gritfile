FILES = "src/main.zig"
OUT = "grit"
DEBUG_FLAGS = "-O Debug -freference-trace=10 -lc"
RELEASE_FLAGS = "-O ReleaseFast -fstrip -lc"

@alias(c)
clean {
    @parallel
    "rm -f *.exe"
    "rm -f *.pdb"
    "rm -f $OUT"
    "rm -f $OUT-d"
}

@default
@alias(d)
debug {
    @if OS == "windows" {
        "zig build-exe $FILES -femit-bin=$OUT-d.exe $DEBUG_FLAGS"
    } @elif OS == "linux" {
        "zig build-exe $FILES -femit-bin=$OUT-d $DEBUG_FLAGS"
    }
}

@alias(r)
release {
    @if OS == "windows" {
        "zig build-exe $FILES -femit-bin=$OUT.exe $RELEASE_FLAGS"
    } @elif OS == "linux" {
        "zig build-exe $FILES -femit-bin=$OUT $RELEASE_FLAGS"
    }
}

@alias(i)
install {
  @if OS == "windows" {
    "copy $OUT.exe c:\grit"
    "copy LICENSE c:\grit"
  } @elif OS == "linux" {
    "sudo install -m 755 grit /usr/local/bin/grit"
  }
}

@alias(g)
gen_cli_md {
    @if OS == "windows" {
        'zig build-exe src/gen_cli_md.zig -femit-bin="gen_cli_md.exe"'
        ".\gen_cli_md.exe"
    } @elif OS == "linux" {
        'zig build-exe src/gen_cli_md.zig'
        "./gen_cli_md"
    }
}

@alias(t)
test {
    "zig test src\parser.zig"
}
